# UZHAVAR-IQ Environment Configuration Example
# Copy this file to .env and insert your API keys

# Kindwise Crop.Health AI API Key (https://crop.kindwise.com/)
EXPO_PUBLIC_CROP_HEALTH_API_KEY=your_crop_health_api_key_here

# Groq Cloud API Key (https://console.groq.com/)
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# Open Government Data API Key (https://data.gov.in/)
EXPO_PUBLIC_GOV_API_KEY=your_data_gov_in_api_key_here

# OpenWeatherMap API Key (https://openweathermap.org/api)
EXPO_PUBLIC_WEATHER_API_KEY=your_openweathermap_api_key_here
